# Copy to .env and fill in. Never commit .env.

# LLM providers (Anthropic for local dev, Bedrock otherwise)
ANTHROPIC_API_KEY=
AWS_REGION=
AWS_PROFILE=

# Postgres (LangGraph checkpoints + memory)
DATABASE_URL=postgresql://triage:triage@localhost:5432/triage

# Tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# GitHub issue tracker (write tool)
GITHUB_TOKEN=
GITHUB_REPO=
